         /// <summary>
+        /// Reads managed assemblies out of the APK through the Android AssetManager (UGF-style
+        /// raw-JNI bridge): open("bin/Data/Managed/<c>Name.dll</c>") then InputStream.read([BII)
+        /// via an explicit method id, copying the JNI array back with ConvertFromJNIArray.
+        /// Deliberately raw JNI — Unity's AndroidJavaObject.Call copies managed byte[] arguments
+        /// one way only (managed → JNI), so a reflection-based read reports a correct byte count
+        /// but hands back a zeroed buffer. Main thread only (JNI; eval is MainThreadRequired
+        /// anyway). Null when the entry cannot be opened or read; the caller compiles without
+        /// that reference and reports the fallout.
+        /// </summary>
+        private static class AndroidApkAssemblies
+        {
+            private static AndroidJavaObject s_Assets;
+            private static IntPtr s_ReadMethodId;
+            private static readonly object s_Lock = new object();
+
+            internal static Stream Open(string assemblyFileName)
+            {
+                try
+                {
+                    lock (s_Lock)
+                    {
+                        if (s_Assets == null)
+                        {
+                            var unityPlayer = new AndroidJavaClass("com.unity3d.player.UnityPlayer");
+                            var activity = unityPlayer.GetStatic<AndroidJavaObject>("currentActivity");
+                            s_Assets = activity.Call<AndroidJavaObject>("getAssets");
+                            activity.Dispose();
+                            unityPlayer.Dispose();
+                            var inputStreamClass = AndroidJNI.FindClass("java/io/InputStream");
+                            s_ReadMethodId = AndroidJNIHelper.GetMethodID(inputStreamClass, "read", "([BII)I");
+                            AndroidJNI.DeleteLocalRef(inputStreamClass);
+                        }
+
+                        using (var input = s_Assets.Call<AndroidJavaObject>("open", $"bin/Data/Managed/{assemblyFileName}"))
+                        {
+                            var output = new MemoryStream();
+                            var args = new jvalue[3];
+                            var chunk = AndroidJNI.NewSByteArray(64 * 1024);
+                            try
+                            {
+                                args[0].l = chunk;
+                                args[1].i = 0;
+                                args[2].i = 64 * 1024;
+                                int read;
+                                while ((read = AndroidJNI.CallIntMethod(
+                                           input.GetRawObject(), s_ReadMethodId, args)) > 0)
+                                {
+                                    var managed = AndroidJNIHelper.ConvertFromJNIArray<sbyte[]>(chunk);
+                                    // sbyte[] and byte[] share the same layout; BlockCopy reinterprets without a
+                                    // per-element loop (MemoryStream.Write needs the unsigned type).
+                                    var bytes = new byte[read];
+                                    Buffer.BlockCopy(managed, 0, bytes, 0, read);
+                                    output.Write(bytes, 0, read);
+                                }
+                            }
+                            finally
+                            {
+                                AndroidJNI.DeleteLocalRef(chunk);
+                            }
+                            if (output.Length == 0)
+                                return null;
+                            output.Position = 0;
+                            return output;
+                        }
+                    }
+                }
+                catch (Exception)
+                {
+                    return null;
+                }
+            }
+        }
