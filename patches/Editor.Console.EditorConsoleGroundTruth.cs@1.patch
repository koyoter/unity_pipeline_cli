+#if UNITY_2022_3
+        // ConsoleWindowUtility does not exist on 2022.3. GetCountsByType is the same native counter
+        // the public API wraps, read through the internal LogEntries the way EditorConsoleEntries
+        // reads it. A failed binding or invocation leaves the counts at zero, which only turns the
+        // dead-callback gap detection into a no-op; the snapshot itself stays valid.
+        static readonly MethodInfo s_GetCountsByType =
+            Type.GetType("UnityEditor.LogEntries,UnityEditor")
+                ?.GetMethod("GetCountsByType", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static);
+
+        static void GetConsoleLogCounts(out int errors, out int warnings, out int logs)
+        {
+            errors = 0;
+            warnings = 0;
+            logs = 0;
+            if (s_GetCountsByType == null)
+                return;
+
+            var args = new object[] { 0, 0, 0 };
+            try
+            {
+                s_GetCountsByType.Invoke(null, args);
+            }
+            catch (Exception)
+            {
+                return;
+            }
+
+            errors = (int)args[0];
+            warnings = (int)args[1];
+            logs = (int)args[2];
+        }
+#endif
